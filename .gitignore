# DFD CMS

# ignore the entire dfd-cms folder so that we can whitelist
# the items that we need.
dfd-cms/

# Dependenciess
node_modules/
*/node_modules/
frontend/node_modules/
backend/node_modules/

# Environment variables
.env
backend/.env
frontend/.env

# Build outputs
frontend/assets/css/style.css
frontend/assets/css/style.css.map

# Logs
*.log
npm-debug.log*

# Runtime data
pids
*.pid
*.seed

# Optional npm cache directory
.npm

# IDE/Editor files
.vscode/
.idea/
*.swp
*.swo

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Project specific
/ror

# VS Code Workspace files
*.code-workspace
# Local Netlify folder
.netlify

# whitelist the items we need in the dfd-cms folder
# whitelist only composer.json in the app/public folder under dfd-cms
!dfd-cms/
!dfd-cms/README.md
!dfd-cms/GRAPHQL_EXAMPLES.md
!dfd-cms/install.sh
!dfd-cms/app/
!dfd-cms/app/public/
!dfd-cms/app/public/composer.json
!dfd-cms/app/public/composer.lock
!dfd-cms/app/public/wp-config-sample.php
!dfd-cms/app/public/wp-config.php
!dfd-cms/app/public/.htaccess
!dfd-cms/app/public/wp-content/
!dfd-cms/app/public/wp-content/themes/
!dfd-cms/app/public/wp-content/mu-plugins/
!dfd-cms/app/public/wp-content/mu-plugins/*.php