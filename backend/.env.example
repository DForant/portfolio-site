# Email Configuration
# For production SMTP server
SMTP_HOST=mail.deanforantdesigns.com
SMTP_PORT=465
SMTP_USER=dean@deanforantdesigns.com
SMTP_PASS=your_email_password

# Alternative Gmail configuration (if needed)
# EMAIL_USER=dean@deanforantdesigns.com
# EMAIL_PASS=your_app_password

# Server Configuration
PORT=3000
NODE_ENV=production

# Frontend URL (for CORS) - comma-separated for multiple origins
# Examples:
# For local development:
# FRONTEND_URL=http://127.0.0.1:5500,http://localhost:5500,http://localhost:3000
# For production:
# FRONTEND_URL=https://deanforantdesigns.com,https://www.deanforantdesigns.com
FRONTEND_URL=http://127.0.0.1:5500
