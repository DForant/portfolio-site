# Email Configuration
# For Gmail, you'll need to:
# 1. Enable 2-factor authentication on your Gmail account
# 2. Generate an "App Password" (not your regular Gmail password)
# 3. Use that app password here

EMAIL_USER=dean@deanforantdesigns.com
EMAIL_PASS=your-app-password-here

# Alternative SMTP Configuration (if not using Gmail)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=dean@deanforantdesigns.com
# SMTP_PASS=your-email-password

# Server Configuration
PORT=3000

# Environment
NODE_ENV=production
