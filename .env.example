# Backend environment example
PORT=4000
NODE_ENV=development

# Allowed frontend origins (comma separated)
FRONTEND_URL=http://localhost:3000,http://127.0.0.1:5500

# SMTP configuration (preferred)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Fallback Gmail credentials (if not using custom SMTP)
EMAIL_USER=
EMAIL_PASS=

# WordPress Headless CMS configuration
# URL to your WordPress installation (without trailing slash)
# Example: https://blog.yourdomain.com or https://yourdomain.com/wp
WORDPRESS_URL=
