# Backend environment example
PORT=4000
NODE_ENV=development

# Allowed frontend origins (comma separated)
FRONTEND_URL=http://localhost:3000,http://127.0.0.1:5500

# SMTP configuration (preferred)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Fallback Gmail credentials (if not using custom SMTP)
EMAIL_USER=
EMAIL_PASS=

# WordPress Headless CMS API Configuration
# For local development: http://dfd-cms.local
# For staging: https://staging-cms.deanforantdesigns.com
# For production: https://cms.deanforantdesigns.com
WP_API_BASE_URL=http://dfd-cms.local

# Optional: Enable debug logging for articles function
ENABLE_ARTICLES_DEBUG=1
