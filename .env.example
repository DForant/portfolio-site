# Backend environment example
PORT=4000
NODE_ENV=development

# Allowed frontend origins (comma separated)
FRONTEND_URL=http://localhost:3000,http://127.0.0.1:5500

# SMTP configuration (preferred)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Fallback Gmail credentials (if not using custom SMTP)
EMAIL_USER=
EMAIL_PASS=

# WordPress Headless CMS API Configuration
# Local development endpoint
WP_API_URL=http://dfd-cms.local/wp-json/wp/v2
# For staging, set: https://staging-cms.deanforantdesigns.com/wp-json/wp/v2
# For production, set: https://cms.deanforantdesigns.com/wp-json/wp/v2
