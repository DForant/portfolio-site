# Backend environment example
PORT=4000
NODE_ENV=development

# Allowed frontend origins (comma separated)
FRONTEND_URL=http://localhost:3000,http://127.0.0.1:5500

# SMTP configuration (preferred)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Fallback Gmail credentials (if not using custom SMTP)
EMAIL_USER=
EMAIL_PASS=

# WordPress CMS API endpoint (for articles)
# Local development
CMS_API_URL=http://dfd-cms.local/wp-json/wp/v2
# Staging (uncomment and update when deploying to staging)
# CMS_API_URL=https://staging-cms.deanforantdesigns.com/wp-json/wp/v2
# Production (set in Netlify environment variables)
# CMS_API_URL=https://cms.deanforantdesigns.com/wp-json/wp/v2
