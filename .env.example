# Backend environment example
PORT=4000
NODE_ENV=development

# Allowed frontend origins (comma separated)
FRONTEND_URL=http://localhost:3000,http://127.0.0.1:5500

# WordPress API endpoint for articles
# Local development: http://dfd-cms.local/wp-json/wp/v2
# Production: https://your-production-cms.com/wp-json/wp/v2
WP_API_BASE_URL=http://dfd-cms.local/wp-json/wp/v2

# SMTP configuration (preferred)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Fallback Gmail credentials (if not using custom SMTP)
EMAIL_USER=
EMAIL_PASS=
