{
    "name": "dfd/cms",
    "description": "Headless CMS for Dean Forant Designs Portfolio",
    "type": "project",
    "autoload": {
        "psr-4": {
            "Dfd\\Cms\\": "src/"
        }
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://wpackagist.org"
        }
    ],
    "authors": [
        {
            "name": "Dean Forant",
            "email": "dforant@gmail.com"
        }
    ],
    "require": {
        "wpackagist-plugin/wordfence": "*@dev"
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true
        }
    }
}
