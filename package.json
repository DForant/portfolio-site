{
  "name": "dean-forant-portfolio",
  "version": "1.0.0",
  "description": "Dean Forant Brand & Web Design Portfolio Website",
  "main": "index.html",
  "scripts": {
    "sass": "sass assets/sass/main.scss assets/css/style.css",
    "sass:watch": "sass --watch assets/sass/main.scss assets/css/style.css",
    "sass:build": "sass assets/sass/main.scss assets/css/style.css --style compressed",
    "start": "node server.js",
    "dev": "nodemon server.js"
  },
  "keywords": [
    "portfolio",
    "brand design",
    "web design",
    "sass"
  ],
  "author": "Dean Forant",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "express-validator": "^7.2.1",
    "helmet": "^7.2.0",
    "nodemailer": "^6.10.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "sass": "^1.90.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DForant/portfolio-site.git"
  },
  "bugs": {
    "url": "https://github.com/DForant/portfolio-site/issues"
  },
  "homepage": "https://github.com/DForant/portfolio-site#readme"
